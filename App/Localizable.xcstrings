    },
    "HealthKit can't read the Fitness app's exact zone boundaries, so an import is a close estimate. Fine-tune below to match exactly.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit no puede leer los límites exactos de las zonas de la app Fitness, así que la importación es una estimación aproximada. Ajústala abajo para que coincida con exactitud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit はフィットネス App で設定されたゾーンの正確な境界を読み取れないため、読み込みは近い概算です。下で微調整して正確に合わせてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit 無法讀取「健身」App 設定的確切區間界線，匯入只是接近的估算。請在下方微調以完全對齊。"
          }
        }
      }
    },
