            "value": "最高 %lld"
          }
        }
      }
    },
    "Quality": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calidad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クオリティ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "品質"
          }
        }
      }
    },
    "Recovery looks limited today. An easy Zone 2 is recommended; a 4×4 runs reduced (3 intervals).": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación parece limitada hoy. Se recomienda Zona 2 suave; el 4×4 se reduce (3 intervalos)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は回復が限られています。軽いZone 2がおすすめ。4×4は短縮（3本）になります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天恢復有限，建議做輕鬆的 Zone 2；若做 4×4 會縮減為 3 組。"
          }
        }
      }
    },
    "Reduced 4×4 anyway": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4×4 reducido igual"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短縮4×4を実行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍做縮減版 4×4"
          }
        }
      }
    },
    "Start a session to see your target.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una sesión para ver tu objetivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを開始すると目標が表示されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始訓練後會顯示你的目標。"
          }
        }
      }
    },
    "Still no reading — check Health access in the watch Settings app, and snug the band.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin lectura: revisa el acceso a Salud en Ajustes del reloj y ajusta la correa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ読み取れません。Watchの設定で「ヘルスケア」のアクセスを確認し、バンドを締め直してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍讀不到心率——請到手錶的「設定」檢查「健康」取用權限，並收緊錶帶。"
          }
        }
      }
    },
    "Too high": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado alto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高すぎます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太高"
          }
        }
      }
    },
    "Too low": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado bajo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低すぎます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太低"
          }
        }
      }
    },
