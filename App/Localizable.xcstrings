          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過"
          }
        }
      }
    },
    "Felt: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensación: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体感: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感覺：%@"
          }
        }
      }
    },
    "Why Zone 2 matters": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué importa Zone 2"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone 2 が大切な理由"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼 Zone 2 重要"
          }
        }
      }
    },
    "Builds aerobic base without piling on fatigue.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye base aeróbica sin acumular demasiada fatiga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "疲労をためすぎずに有酸素の土台を作ります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立有氧基礎，同時不累積太多疲勞。"
          }
        }
      }
    },
    "You should be able to speak in short sentences.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deberías poder hablar en frases cortas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い文なら話せる強度が目安です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你應該還能用短句說話。"
          }
        }
      }
    },
    "Heart-rate zones matter more than pace on easy days.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En días fáciles, las zonas de frecuencia importan más que el ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イージーデイはペースより心拍ゾーンが大切です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕鬆日心率區間比配速更重要。"
          }
        }
      }
    },
    "How 4×4 should feel": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo debe sentirse 4×4"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4×4 の体感目安"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4×4 應該是什麼感覺"
          }
        }
      }
    },
    "Hard means controlled: strong breathing, not an all-out sprint.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duro significa controlado: respiración fuerte, no sprint total."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードは制御できる強度です。全力スプリントではなく、呼吸が強い状態です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高強度要可控：呼吸很重，但不是全力衝刺。"
          }
        }
      }
    },
    "Recoveries matter because your heart rate needs room to drop.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recuperaciones importan porque tu frecuencia necesita bajar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍を下げる余地を作るため、回復区間も大切です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復段很重要，因為心率需要有下降空間。"
          }
        }
      }
    },
    "Do not chase hard intervals every day; adaptation happens between sessions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No persigas intervalos duros todos los días; la adaptación ocurre entre sesiones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日ハードインターバルを追わないでください。適応はセッションの間に起こります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要每天追高強度間歇；身體是在訓練之間適應。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
