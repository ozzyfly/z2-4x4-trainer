    "No account, no server. Everything lives on your iPhone and Apple Watch." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, kein Server. Alles bleibt auf deinem iPhone und deiner Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta y sin servidor. Todo vive en tu iPhone y Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de serveur. Tout reste sur votre iPhone et votre Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントもサーバーも不要。すべてはあなたのiPhoneとApple Watchの中に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정도 서버도 없습니다. 모든 것이 iPhone과 Apple Watch에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem servidor. Tudo fica no seu iPhone e Apple Watch."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需帳號、沒有伺服器。一切都存在你的 iPhone 與 Apple Watch 上。"
          }
        }
      }
    },
