            "state": "translated",
            "value": "3 週間連続"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續三週"
          }
        }
      }
    },
    "Completed your first Norwegian 4×4 session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completaste tu primera sesión noruega 4×4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めてのノルウェー式 4×4 セッションを完了しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成了你的第一次挪威 4×4 訓練。"
          }
        }
      }
    },
    "Consistent Month": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes constante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "継続した 1 か月"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "穩定的一個月"
          }
        }
      }
    },
    "First 4×4": {
      "localizations": {
        "es": {
