            "value": "ハード平均 %lld · ピーク %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高強度平均 %lld · 最高 %lld"
          }
        }
      }
    },
    "Build toward %lld–%lld bpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hacia %lld–%lld ppm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld bpm を目指して上げます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐步提高到 %lld–%lld bpm。"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Do Zone 2 instead": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor haz Zona 2"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりにZone 2"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改做 Zone 2"
          }
        }
      }
    },
    "Ease back to %lld–%lld bpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja a %lld–%lld ppm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld bpm まで少し落とします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放慢回到 %lld–%lld bpm。"
          }
        }
      }
    },
    "Effective Zone 2": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone 2 efectiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な Zone 2"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有效 Zone 2"
          }
        }
      }
    },
    "Hard time %lldm · recoveries %lld/%lld": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo duro %lldm · recuperaciones %lld/%lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハード時間 %lld分 · 回復 %lld/%lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高強度時間 %lld分 · 恢復 %lld/%lld"
          }
        }
      }
    },
    "Hold %lld–%lld bpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %lld–%lld ppm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld bpm を維持します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持在 %lld–%lld bpm。"
          }
        }
      }
    },
    "In zone %lld% of %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En zona %lld% de %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中 %1$lld% がゾーン内"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中有 %1$lld% 在區間內"
          }
        }
      }
    },
    "Keep going": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "Keep moving while Apple Watch locks onto your heart rate.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue moviéndote mientras Apple Watch detecta tu frecuencia cardíaca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch が心拍数を検出するまで動き続けてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 鎖定心率時請保持活動。"
          }
        }
      }
    },
    "Low readiness": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja preparación"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復不足"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復狀態不佳"
          }
        }
      }
    },
    "Nice work!": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Buen trabajo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナイスワーク！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做得好！"
          }
        }
      }
    },
    "No target": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin objetivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標なし"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有目標"
          }
        }
      }
    },
