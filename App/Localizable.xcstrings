    "Build your aerobic base and lift your fitness with workouts tuned to you — Zone 2 easy days and Norwegian 4×4 intervals.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desarrolla tu base aeróbica y mejora tu forma física con entrenamientos a tu medida: días suaves de Zona 2 e intervalos noruegos 4×4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたに合わせたワークアウトで有酸素ベースを築き、体力を高めましょう——Zone 2 のイージーデイとノルウェー式 4×4 インターバル。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用為你量身打造的訓練建立有氧基礎、提升體能——Zone 2 輕鬆日與挪威式 4×4 間歇。"
          }
        }
      }
    },
    "Connect Apple Health": {
      "extractionState": "manual",
      "localizations": {
        "es": {
