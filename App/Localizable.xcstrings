{
  "sourceLanguage": "en",
  "strings": {
    "Auto-import workouts": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar entrenamientos automáticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウトを自動取り込み"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動匯入運動"
          }
        }
      }
    },
    "When on, workouts recorded elsewhere (Apple Health, other apps) are added to your history. Turn off to keep only your watch and manual sessions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, los entrenamientos registrados en otro lugar (Apple Health, otras apps) se añaden a tu historial. Desactívalo para conservar solo tus sesiones del reloj y manuales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、他の場所（Apple ヘルスケアや他アプリ）で記録したワークアウトが履歴に追加されます。オフにすると時計と手動のセッションのみ残します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時，其他地方（Apple Health、別的 app）記錄的運動會加進歷史。關閉則只保留手錶與手動記錄的。"
          }
        }
      }
    },
