    "Set all five zones to match Apple Watch — import from Health or enter them by hand.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura las cinco zonas para que coincidan con el Apple Watch: impórtalas desde Salud o introdúcelas a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 つのゾーンすべてを Apple Watch に合わせて設定 — ヘルスケアから読み込むか手動で入力します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定全部五個區間以對齊 Apple Watch — 可從「健康」匯入或手動輸入。"
          }
        }
      }
    },
