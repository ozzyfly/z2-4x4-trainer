          "stringUnit": {
            "state": "translated",
            "value": "心拍数、ワークアウト、アクティブエネルギー、安静時心拍数、VO2 max、体重を使ってゾーン、準備度、週間目標を計算します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "心率、運動紀錄、活動熱量、靜止心率、VO2 max 與體重會用來計算區間、準備度和每週目標。"
          }
        }
      }
    },
    "Writes only your workouts": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe solo tus entrenamientos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウトだけを書き込みます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只寫入你的訓練紀錄"
          }
        }
      }
    },
    "Zone 2 and Norwegian 4×4 sessions can be saved back to Apple Health when you allow it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones Zone 2 y Norwegian 4×4 pueden guardarse en Apple Health cuando lo permitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、Zone 2 とノルウェー式 4×4 セッションを Apple Health に保存できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你允許後，Zone 2 和挪威 4×4 訓練可以儲存回 Apple Health。"
          }
        }
      }
    },
    "Private by design": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado por diseño"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーを前提に設計"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以隱私為核心設計"
          }
        }
      }
    },
    "No account, no server. Your training data stays on your iPhone and Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin servidor. Tus datos de entrenamiento se quedan en tu iPhone y Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもサーバーも不要。トレーニングデータは iPhone と Apple Watch に残ります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用帳號、沒有伺服器。你的訓練資料會留在 iPhone 和 Apple Watch 上。"
          }
        }
      }
    },
    "How did it feel?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se sintió?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どう感じましたか？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感覺如何？"
          }
        }
      }
    },
    "Your answer helps tune future targets without needing more health data.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta ayuda a ajustar objetivos futuros sin necesitar más datos de salud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答すると、追加のヘルスデータなしで今後の目標調整に役立ちます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答能幫助調整未來目標，不需要更多健康資料。"
          }
        }
      }
    },
    "Easy": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
