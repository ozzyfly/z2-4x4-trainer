    "Hard means controlled: strong breathing, not an all-out sprint." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hart heißt kontrolliert: kräftige Atmung, kein All-out-Sprint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duro significa controlado: respiración fuerte, no sprint total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dur signifie contrôlé : respiration forte, pas un sprint total."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードは制御できる強度です。全力スプリントではなく、呼吸が強い状態です。"
