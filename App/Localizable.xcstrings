    "Heart rate, workouts, active energy, resting heart rate, VO2 max, and body weight help calculate zones, readiness, and weekly targets." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfrequenz, Workouts, Aktivitätsenergie, Ruhepuls, VO2 max und Gewicht dienen zur Berechnung von Zonen, Bereitschaft und Wochenzielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia cardíaca, entrenamientos, energía activa, frecuencia en reposo, VO2 máx. y peso ayudan a calcular zonas, preparación y objetivos semanales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC, entraînements, énergie active, FC au repos, VO2 max et poids servent à calculer zones, forme et objectifs hebdo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数、ワークアウト、アクティブエネルギー、安静時心拍数、VO2 max、体重を使ってゾーン、準備度、週間目標を計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수, 운동, 활동 에너지, 안정 시 심박수, VO2 max, 체중은 존·준비도·주간 목표 계산에 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC, treinos, energia ativa, FC em repouso, VO2 max e peso ajudam a calcular zonas, prontidão e metas semanais."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率、運動紀錄、活動熱量、靜止心率、VO2 max 與體重會用來計算區間、準備度和每週目標。"
          }
        }
      }
    },
