{
  "sourceLanguage": "en",
  "strings": {
    "No target": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin objetivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標なし"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有目標"
          }
        }
      }
    },
    "Too low": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado bajo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低すぎます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太低"
          }
        }
      }
    },
    "Too high": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado alto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高すぎます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太高"
          }
        }
      }
    },
    "Start a session to see your target.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una sesión para ver tu objetivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを開始すると目標が表示されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始訓練後會顯示你的目標。"
          }
        }
      }
    },
    "Keep moving while Apple Watch locks onto your heart rate.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue moviéndote mientras Apple Watch detecta tu frecuencia cardíaca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch が心拍数を検出するまで動き続けてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 鎖定心率時請保持活動。"
          }
        }
      }
    },
    "Build toward %lld–%lld bpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hacia %lld–%lld ppm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld bpm を目指して上げます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐步提高到 %lld–%lld bpm。"
          }
        }
      }
    },
    "Hold %lld–%lld bpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %lld–%lld ppm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld bpm を維持します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持在 %lld–%lld bpm。"
          }
        }
      }
    },
    "Ease back to %lld–%lld bpm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja a %lld–%lld ppm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld bpm まで少し落とします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放慢回到 %lld–%lld bpm。"
          }
        }
      }
    },
