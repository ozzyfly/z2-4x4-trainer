    "Apple Watch derives workout zones from your heart-rate reserve, so its numbers differ from age-based ones. Import to estimate them from Health, or type the exact values from the Fitness app for a perfect match.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Watch calcula las zonas de entrenamiento a partir de tu reserva de frecuencia cardíaca, por lo que sus valores difieren de los basados en la edad. Impórtalas desde Salud para estimarlas o introduce los valores exactos de la app Fitness para una coincidencia perfecta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch は心拍予備能からワークアウトのゾーンを算出するため、年齢ベースの値とは異なります。ヘルスケアから読み込んで概算するか、フィットネス App に表示される正確な値を入力すると完全に一致します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 以心率儲備推算運動區間，數值會和以年齡推算的不同。可從「健康」匯入做估算，或照「健身」App 顯示的數值手動輸入以完全對齊。"
          }
        }
      }
    },
    "From Health": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde Salud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「健康」"
          }
        }
      }
    },
    "Import from Health": {
      "extractionState": "manual",
      "localizations": {
