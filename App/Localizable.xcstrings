    "Resting HR is required for heart-rate-reserve zones. Without it, zones fall back to age-based." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Herzfrequenzreserve-Zonen ist der Ruhepuls nötig. Ohne ihn gelten altersbasierte Zonen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las zonas de reserva de frecuencia cardíaca requieren la FC en reposo. Sin ella, las zonas vuelven al cálculo según la edad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La FC au repos est requise pour les zones en réserve cardiaque. Sinon, retour aux zones selon l’âge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍予備能ゾーンには安静時心拍数が必要です。設定されていない場合、ゾーンは年齢ベースに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수 예비량 존에는 안정 시 심박수가 필요합니다. 없으면 나이 기반으로 대체됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FC em repouso é necessária para zonas por reserva de FC. Sem ela, as zonas voltam ao padrão por idade."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率儲備區間需要靜止心率。若未設定，區間將改用依年齡推算的預設值。"
          }
        }
      }
    },
