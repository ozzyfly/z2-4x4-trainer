    "Tunes how the watch's adaptive 4×4 starts and ends each segment.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta cómo el 4×4 adaptativo del reloj inicia y termina cada segmento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の適応型 4×4 が各区間を開始・終了するタイミングを調整します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整手錶自適應 4×4 各段的開始與結束時機。"
          }
        }
      }
    },
    "Readiness is low — today's session is reduced to %lld hard blocks.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparación es baja: la sesión de hoy se reduce a %lld bloques intensos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レディネスが低めです — 本日のセッションは高強度 %lld ブロックに短縮されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness 偏低 — 今天課表減為 %lld 組高強度。"
          }
        }
      }
    },
