    "Hold a steady, conversational effort. Stay in your Zone 2 band for the whole session.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un esfuerzo constante en el que puedas conversar. Permanece en tu banda de Zona 2 durante toda la sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話できる程度の一定の強度を保ちます。セッション中はずっと Zone 2 の範囲内にとどまりましょう。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持穩定、能正常對話的強度。整個訓練都待在你的 Zone 2 區間內。"
          }
        }
      }
    },
    "Holding steady — finish this week strong.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
