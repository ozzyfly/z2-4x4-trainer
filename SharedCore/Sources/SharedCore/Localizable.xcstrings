            "value": "10 次訓練"
          }
        }
      }
    },
    "3-Week Streak": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racha de 3 semanas"
          }
        },
        "ja": {
