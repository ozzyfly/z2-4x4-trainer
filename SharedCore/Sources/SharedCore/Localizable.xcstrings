    "Fitter": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más en forma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より健康に"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更健康"
          }
        }
      }
    },
    "Great day for a hard 4×4.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gran día para un 4×4 intenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードな 4×4 に最適な日です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天很適合進行高強度 4×4。"
          }
        }
      }
    },
    "Hit your weekly training target 4 weeks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcanzaste tu objetivo semanal de entrenamiento durante 4 semanas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間トレーニング目標を 4 週間達成しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續四週達成每週訓練目標。"
          }
        }
      }
    },
    "Logged 10 workouts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registraste 10 entrenamientos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 回のワークアウトを記録しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記錄 10 次運動。"
          }
        }
      }
    },
    "Prioritise recovery — keep it easy or rest.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza la recuperación: tómatelo con calma o descansa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復を優先しましょう。軽めにするか休んでください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先恢復——放輕鬆或休息。"
          }
        }
      }
    },
    "Steady aerobic work today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo aeróbico moderado hoy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は安定した有酸素運動を。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天進行穩定的有氧運動。"
          }
        }
      }
    },
    "Trained at least once a week for 3 weeks running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrenaste al menos una vez por semana durante 3 semanas seguidas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3 週間連続で週に 1 回以上トレーニングしました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續三週每週至少訓練一次。"
          }
        }
      }
    },
    "Your VO2max is up since you started.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VO2máx ha subido desde que empezaste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時より VO2max が向上しています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自從你開始以來，你的最大攝氧量已提升。"
          }
        }
      }
    }
